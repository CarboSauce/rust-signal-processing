import {
    Button,
    VerticalBox,
    HorizontalBox,
    StandardButton,
    ScrollView,
} from "std-widgets.slint";

struct ImageChannelCalculatedData { average: float, median: float, variance: float, std_deviation: float }

struct ImageCalculatedData {
    red_data: ImageChannelCalculatedData,
    green_data: ImageChannelCalculatedData,
    blue_data: ImageChannelCalculatedData
}

struct Area { x: int, y: int, width: int, height: int }

export component ErrorDialog inherits Dialog {
    in property <string> error-text;
    title: "Error while opening the file";
    Text {
        text: error-text;
    }

    StandardButton {
        kind: ok;
        clicked => { root.close(); }
    }
}

export component CanceledDialog inherits Dialog {
    title: "Canceled operation";

    Text {
        text: "Operation has been canceled";
    }

    StandardButton {
        kind: ok;
        clicked => { root.close(); }
    }
}

component ChannelData {
    in property <string> channel-name;
    in property <ImageChannelCalculatedData> data;

    VerticalBox {
        Text {
            text: channel-name;
        }

        Text {
            text: "Average of pixels: \{data.average}";
        }

        Text {
            text: "Median of pixels: \{data.median}";
        }

        Text {
            text: "Variance of pixels: \{data.variance}";
        }

        Text {
            text: "Standard deviation of pixels: \{data.std-deviation}";
        }
    }
}

export component ImageDataDialog inherits Dialog {
    in property <ImageCalculatedData> image_data;
    title: "Image data in selected region";

    HorizontalBox {

        HorizontalBox {
            ChannelData {
                channel-name: "Red channel";
                data: image_data.red-data;
            }

            ChannelData {
                channel-name: "Green channel";
                data: image_data.green-data;
            }

            ChannelData {
                channel-name: "Blue channel";
                data: image_data.blue-data;
            }
        }
    }

    StandardButton {
        kind: ok;
        clicked => { root.close(); }
    }
}

struct DraggingContext {
    is_dragging: bool,
    last_x: length,
    last_y: length,
    cur_x: length,
    cur_y: length,
}

export component PixelStatPage inherits VerticalBox {
    in-out property original-image <=> original.source;
    callback file-open();
    callback calculate-data(Area);

    private property <DraggingContext> drag: {
        is_dragging: false,
        last_x: 0,
        last_y: 0,
        cur_x: 0,
        cur_y: 0,
    };
    function reset_dragging() {
        drag.is-dragging = false;
        drag.cur-x = 0;
        drag.cur-y = 0;
        drag.last-x = 0;
        drag.last-x = 0;
    }

    HorizontalBox {
        VerticalBox {
            ScrollView {
                width: 100%;
                height: 100%;
                content-width: original.width;
                content-height: original.height;
                area := TouchArea {
                    width: original.width;
                    height: original.height;
                    clicked => {
                        drag.is-dragging = !drag.is-dragging;
                        if drag.is-dragging {
                            drag.last-x = area.pressed-x;
                            drag.last-y = area.pressed-y;
                        } else {
                            calculate-data({
                                x: min(drag.last-x, area.mouse-x) / 1px,
                                y: min(drag.last-y, area.mouse-y) / 1px,
                                width: abs(area.mouse-x - drag.last-x) / 1px,
                                height: abs(area.mouse-y - drag.last-y) / 1px,
                            });
                        }
                    }

                    original := Image {
                        image-fit: preserve;
                    }

                    if drag.is-dragging: Rectangle {
                        border-color: black;
                        border-width: 5px;

                        x: min(drag.last-x, area.mouse-x);
                        y: min(drag.last-y, area.mouse-y);

                        width: abs(area.mouse-x - drag.last-x);
                        height: abs(area.mouse-y - drag.last-y);
                    }
                }
            }
        }
    }
}

export component BlpPage inherits VerticalBox {
    in-out property original-image <=> original.source;
    in-out property blp-image <=> blp-img.source;
    in-out property hist-image <=> hist-img.source;
    pure callback calculate-histogram(image) -> image;
    pure callback calculate-blp(image) -> image;
    callback save-histogram(image);

    VerticalBox {
        HorizontalBox {
            VerticalBox {
                Text {
                    font-size: 20px;
                    text: "Original Image";
                    horizontal-alignment: center;
                }

                original := Image {
                    image-fit: contain;
                }
            }

            VerticalBox {
                Text {
                    font-size: 20px;
                    text: "Binary local pattern";
                    horizontal-alignment: center;
                }

                blp-img := Image {
                    source: calculate-blp(original-image);
                    image-fit: contain;
                }
            }
        }

        VerticalBox {
            Text {
                font-size: 20px;
                text: "Histogram";
                horizontal-alignment: center;
            }

            ContextMenuArea {
                hist-img := Image {
                    source: calculate-histogram(blp-image);
                    image-fit: contain;
                }

                Menu {
                    MenuItem {
                        title: "Save";
                        activated => {
                            save-histogram(hist-image)
                        }
                    }
                }
            }
        }
    }
}


export enum WindowState {
    PixelInfo,
    BinaryLocalPattern,
}

export component AppWindow inherits Window {
    in-out property <WindowState> state: WindowState.PixelInfo;
    in-out property <image> original-image;
    callback calculate-data(Area);
    pure callback calculate-blp(image) -> image;
    pure callback calculate-histogram(image) -> image;
    callback save-histogram(image);
    callback file-open();
    title: "Rust signal processing examples";
    preferred-width: 800px;
    preferred-height: 600px;
    MenuBar {
        Menu {
            title: "Functions";
            MenuItem {
                title: "Pixel info";
                activated => {
                    state = WindowState.PixelInfo;
                }
            }

            MenuItem {
                title: "Binary local pattern";
                activated => {
                    state = WindowState.BinaryLocalPattern;
                }
            }
        }

        Menu {
            title: "File";
            MenuItem {
                title: "Open";
                activated => {
                    file-open()
                }
            }
        }
    }

    VerticalLayout {
        if (state == WindowState.PixelInfo): PixelStatPage {
            original-image: original-image;
            calculate-data(a) => calculate-data(a);
        }
        if (state == WindowState.BinaryLocalPattern): BlpPage {
            original-image: original-image;
            calculate-blp(img) => calculate-blp(img);
            calculate-histogram(img) => calculate-histogram(img);
            save-histogram(img) => save-histogram(img);
        }
    }
}
